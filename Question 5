#include <stdio.h>
int main() {
    int time, motion, light, room, cooking = 0
    printf("Enter time (0-23): ");
    scanf("%d", &time);
    printf("Enter motion detected (1/0): ");
    scanf("%d", &motion);
    printf("Enter light level (0-100): ");
    scanf("%d", &light);
    printf("Select room (1 = Living Room, 2 = Bedroom, 3 = Kitchen): ");
    scanf("%d", &room);
    if (room == 3) {
        printf("Enter cooking status (1 = yes, 0 = no): ");
        scanf("%d", &cooking);
    }
    if (cooking == 1) {
        if (time >= 6 && time < 18 && motion == 1) {
            printf("Mode: Day mode, Action: lights ON and exhaust fan ON\n");
        } else if (time >= 18 && time < 23 && motion == 1) {
            printf("Mode: Evening mode, Action: dim lights and exhaust fan ON\n");
        } else if (time >= 23 || time < 6) {
            printf("Mode: Night mode, Action: lights OFF and exhaust fan ON\n");
        } else {
            printf("Mode: Custom, Action: exhaust fan ON\n");
        }
    } else {
        if (motion == 0) {
            printf("Mode: Away mode, Action: all OFF\n");
        } else if (time >= 6 && time < 18) {
            printf("Mode: Day mode, Action: lights ON\n");
        } else if (time >= 18 && time < 23) {
            printf("Mode: Evening mode, Action: dim lights\n");
        } else {
            printf("Mode: Night mode, Action: lights OFF\n");
        }
    }
}
