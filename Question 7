#include <stdio.h>
int main() {
    int stream, interest, medicine;    
    printf("Ask for stream (1 = Science, 2 = Commerce, 3 = Arts): ");
    scanf("%d", &stream);
    if (stream == 1) {
        printf("Choose interest (1 = Biology, 2 = Physics, 3 = Chemistry): ");
        scanf("%d", &interest);
        if (interest == 1) {
            printf("Interested in medicine? (1 = Yes, 0 = No): ");
            scanf("%d", &medicine);
            if (medicine == 1) {
                printf("Recommended course: MBBS\n");
            } else {
                printf("Recommended course: Biotechnology\n");
            }
        } else if (interest == 2) {
            printf("Recommended course: B.Sc. Physics\n");
        } else if (interest == 3) {
            printf("Recommended course: B.Sc. Chemistry\n");
        } else {
            printf("Invalid choice\n");
        }
    } else if (stream == 2) {
        printf("Choose interest (1 = Accounting, 2 = Marketing): ");
        scanf("%d", &interest);
        if (interest == 1) {
            printf("Recommended course: B.Com / Accounting & Finance\n");
        } else if (interest == 2) {
            printf("Recommended course: BBA / Marketing\n");
        } else {
            printf("Invalid choice\n");
        }
    } else if (stream == 3) {
        printf("Choose interest (1 = Literature, 2 = History, 3 = Psychology): ");
        scanf("%d", &interest);
        if (interest == 1) {
            printf("Recommended course: B.A. English Literature\n");
        } else if (interest == 2) {
            printf("Recommended course: B.A. History\n");
        } else if (interest == 3) {
            printf("Recommended course: B.Sc. / B.A. Psychology\n");
        } else {
            printf("Invalid choice\n");
        }
    } else {
        printf("Invalid choice\n");
    }
}
