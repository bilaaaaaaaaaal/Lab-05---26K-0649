#include <stdio.h>
int main(){
    int vehicle, hours, membership;
    float fee;
    printf("enter vehicle type\n");
    scanf("%d",&vehicle);
    printf("enter hours parked\n");
    scanf("%d",&hours);
    printf("enter membership status");
    scanf("%d",&membership);
    if(vehicle>3||vehicle<1){
        printf("invalid vehicle");
    }
    else{
        if(hours<=0){
            printf("Invalid duration");
        }
        else{
            if(vehicle==1){
                fee=20*hours;
            }
            else if(vehicle==2){
                if(hours<=2){
                    fee=50;
                }
                else{
                    fee=50+(30*(hours-2));
                }
            }
            else{
                if(hours<=3){
                    fee=100;
                }
                else{
                    fee=100+(50*(hours-3));
                }
            }

        }
    }
    if(membership==1 && fee>200){
        fee=fee*0.85;
    }
    printf("final fee is %.02f",fee);
}
